# Rename this file to secrets.toml (locally) or paste its contents into
# Streamlit Community Cloud -> App settings -> Secrets when deploying.

[supabase]
url = "https://YOUR-PROJECT-REF.supabase.co"
key = "YOUR-SUPABASE-ANON-OR-SERVICE-KEY"

# Predefined username/password -> role gate.
# Add as many users as you like. role must be "business" or "admin".
[users]
biz_user1   = { password = "changeme1", role = "business" }
biz_user2   = { password = "changeme2", role = "business" }
admin_user1 = { password = "changeme3", role = "admin" }
